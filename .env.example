# Local development uses your existing MySQL. Cloud MySQL values go in Vercel.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=seshachandra_creations
# Remote hosts always use verified TLS. Paste the provider CA as PEM or escaped \n.
MYSQL_SSL=false
MYSQL_SSL_CA=
# Set false when your provider already created the database (e.g. Aiven defaultdb).
MYSQL_CREATE_DATABASE=true
SITE_URL=http://localhost:4173
UPLOAD_DIRECTORY=data/uploads
# Required in production. Keep the bucket PRIVATE. R2 is S3-compatible.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional YouTube Data API v3 key, server-only.
YOUTUBE_API_KEY=
# No default admin password. Use npm run admin:create -- your@email.com.
