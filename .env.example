# Copy to .dev.vars for local optional credentials. Never commit .dev.vars.
# Hosted admin IDs are obtained after ChatGPT sign-in at /admin.
ADMIN_USER_IDS=
# Optional YouTube Data API v3 key. Manual entry does not need it.
YOUTUBE_API_KEY=
# DB and BUCKET are platform bindings declared in .openai/hosting.json.
# Local loopback development uses the starter's local_seedy identity.
# That identity is explicitly rejected in production, even if allowlisted.
